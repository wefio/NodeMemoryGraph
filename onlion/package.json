{
  "name": "@node-memory-graph/onlion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-backend.mjs",
    "build:edgeone": "node scripts/build-edgeone.mjs",
    "deploy:edgeone": "edgeone makers deploy ./dist/edgeone -n nmg-memory-api --json",
    "check": "tsc --noEmit",
    "start": "node node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .runtime/wrangler --ip 127.0.0.1 --inspector-port 0",
    "test:backend": "node scripts/test-backend.mjs",
    "test:temporal": "node --experimental-transform-types scripts/test-temporal-evidence.mjs",
    "test:media": "node --experimental-transform-types scripts/test-multimodal-service.mjs",
    "test:worker-media": "node scripts/test-multimodal-worker.mjs",
    "test:cos": "node scripts/test-cos-bucket.mjs",
    "test:edgeone": "node scripts/test-edgeone-worker.mjs",
    "verify": "npm run build && npm run check && npm run test:temporal && npm run test:media && npm run test:backend && npm run test:append-log && npm run test:manifest-pending && npm run test:add-log && npm run test:page-delta && npm run test:extractive && npm run test:mem && npm run test:worker-media",
    "generate:callbacks": "node scripts/generate-callbacks.mjs",
    "smoke:edgeone": "node scripts/smoke-edgeone.mjs",
    "test:add-log": "node scripts/test-add-log-mode.mjs",
    "test:append-log": "node scripts/test-append-log.mjs",
    "test:manifest-pending": "node scripts/test-manifest-pending.mjs",
    "test:page-delta": "node scripts/test-page-delta.mjs",
    "test:extractive": "node --experimental-transform-types scripts/test-extractive-summaries.mjs",
    "test:mem": "node scripts/test-mem-trace.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.28.1",
    "miniflare": "4.20260515.0",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "search-query-parser": "1.6.0"
  }
}
