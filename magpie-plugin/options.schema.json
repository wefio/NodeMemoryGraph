{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataDirectory": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535, "default": 3487 },
    "maxCharacters": { "type": "integer", "minimum": 2000, "maximum": 32000, "default": 16000 },
    "gatewayTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 1000 },
    "coordination": { "type": "boolean", "default": true },
    "nativeCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      }
    }
  }
}
