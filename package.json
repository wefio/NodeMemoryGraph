{
  "name": "node-memory-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first long-term memory for the Pi agent harness",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/nmg.ts"
    ]
  },
  "files": [
    "extensions/nmg.ts",
    ".pi/extensions/nmg/index.ts",
    "src/core/gate.ts",
    "src/core/hierarchy.ts",
    "src/core/router.ts",
    "src/core/store.ts",
    "src/core/types.ts",
    "src/core/vector-cache.ts",
    "src/core/vector.ts",
    "src/core/write-policy.ts"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "eval:agents": "node --experimental-strip-types evals/run.ts",
    "eval:adaptive": "node --experimental-strip-types evals/adaptive-topology/run.ts",
    "eval:quality": "node --experimental-strip-types evals/memory-quality/run.ts",
    "eval:longmem": "node --experimental-strip-types evals/longmemeval/run.ts",
    "eval:recall-compression": "node --experimental-strip-types evals/recall-compression.ts",
    "eval:scale": "node --experimental-strip-types evals/scale/run.ts",
    "eval:hierarchy": "node --experimental-strip-types evals/hierarchy-scale/run.ts",
    "index:qwen3": "node --experimental-strip-types scripts/index-qwen3.ts",
    "index:ann": "node --experimental-strip-types scripts/build-ann.ts",
    "pi:prompt": "node --experimental-strip-types scripts/pi-control.ts prompt",
    "pi:state": "node --experimental-strip-types scripts/pi-control.ts state",
    "test": "node --experimental-strip-types --test src/core/store.test.ts src/core/gate.test.ts src/core/openai-embedding.test.ts src/core/ann.test.ts src/core/vector-cache.test.ts src/core/write-policy.test.ts .pi/extensions/nmg/index.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "24.12.4",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "optionalDependencies": {
    "usearch": "2.26.0"
  }
}
