{
  "name": "node-memory-graph",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first long-term memory and optional Lab capabilities for agent harnesses",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/nmg.ts"
    ]
  },
  "bin": {
    "nmg": "./bin/nmg.mjs"
  },
  "files": [
    "bin/nmg.mjs",
    "dist/",
    "proto/",
    "scripts/tutorial-first-recall.ts",
    "extensions/nmg.ts",
    ".pi/extensions/nmg/index.ts",
    ".pi/extensions/nmg/controller-shadow.ts",
    "skills/",
    "src/cli/",
    "src/core/",
    "src/integration/",
    "src/prompts/",
    "src/lab/autodiff.ts",
    "src/lab/controller-protocol.ts",
    "src/lab/controller-runtime.ts",
    "src/lab/differentiable-controller.ts",
    "src/lab/memory-graph-reasoner.ts",
    "src/lab/shadow-evaluation.ts",
    "src/lab/skillopt-policy.ts",
    "src/lab/reasoning-workspace.ts"
  ],
  "scripts": {
    "prompts:generate": "node --experimental-strip-types scripts/generate-prompts.ts",
    "prompts:check": "node --experimental-strip-types scripts/generate-prompts.ts --check",
    "build": "npm run prompts:generate && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/cli/graph/assets','dist/cli/graph/assets',{recursive:true})\"",
    "check": "npm run prompts:check && tsc --noEmit",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "tutorial:first-recall": "node --experimental-strip-types scripts/tutorial-first-recall.ts",
    "lint": "eslint src/ .pi/extensions/ claude-plugins/",
    "lint:fix": "eslint --fix src/ .pi/extensions/ claude-plugins/",
    "format": "prettier --write \"src/**/*.ts\" \".pi/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \".pi/**/*.ts\"",
    "test:coverage": "c8 node --experimental-strip-types --test --test-concurrency=2 \"tests/cli/**/*.test.ts\" \"tests/core/**/*.test.ts\" \"tests/docker/**/*.test.ts\" \"tests/docs/**/*.test.ts\" \"tests/extensions/**/*.test.ts\" \"tests/guardrails/**/*.test.ts\" \"tests/integration/**/*.test.ts\" \"tests/prompts/**/*.test.ts\" \"tests/scripts/**/*.test.ts\" \"tests/skills/**/*.test.ts\" \"tests/support/**/*.test.ts\" \"tests/tools/**/*.test.ts\"",
    "eval:agents": "node --experimental-strip-types evals/run.ts",
    "hotspot:modules": "node --experimental-strip-types scripts/hotspot-files.ts",
    "perf:hotspots": "node --experimental-strip-types scripts/perf-hotspots.ts",
    "eval:adaptive": "node --experimental-strip-types evals/adaptive-topology/run.ts",
    "eval:controller": "node --experimental-strip-types evals/controller/run.ts",
    "eval:controller-shadow": "node --experimental-strip-types evals/controller-shadow/report.ts",
    "eval:natural-maintenance": "node --experimental-strip-types evals/natural-maintenance/audit.ts",
    "eval:controller-dataset": "node --experimental-strip-types evals/controller-shadow/dataset.ts",
    "eval:controller-calibrate": "node --experimental-strip-types evals/controller-shadow/calibrate.ts",
    "eval:natural-readiness": "node --experimental-strip-types evals/natural-readiness/report.ts",
    "eval:qpp-tau": "node --experimental-strip-types evals/controller-shadow/tau-worker.ts",
    "eval:skillopt:export": "node --experimental-strip-types evals/skillopt/export.ts",
    "eval:skillopt:install": "node --experimental-strip-types evals/skillopt/install-adapter.ts",
    "eval:consolidation": "node --experimental-strip-types evals/consolidation/run.ts",
    "eval:topology": "node --experimental-strip-types evals/topology/run.ts",
    "eval:topology:bpid": "node --experimental-strip-types evals/topology/bpid.ts",
    "eval:topology:namesakes": "node --experimental-strip-types evals/topology/namesakes.ts",
    "eval:topology:namesakes-agent": "node --experimental-strip-types evals/topology/namesakes-agent.ts",
    "eval:halumem:prepare": "node --experimental-strip-types evals/halumem/prepare.ts",
    "eval:halumem:agent-extract": "node --experimental-strip-types evals/halumem/agent-extract.ts",
    "eval:halumem:promotion-audit": "node --experimental-strip-types evals/halumem/promotion-audit.ts",
    "eval:halumem:score": "node --experimental-strip-types evals/halumem/score.ts",
    "eval:quality": "node --experimental-strip-types evals/memory-quality/run.ts",
    "eval:retrieval": "node --experimental-strip-types evals/retrieval/run.ts",
    "eval:longmem": "node --experimental-strip-types evals/longmemeval/run.ts",
    "eval:gate": "node --experimental-strip-types evals/gate/run.ts",
    "eval:disclosure": "node --experimental-strip-types evals/disclosure/run.ts",
    "eval:locomo": "node --experimental-strip-types evals/benchmarks/run.ts locomo",
    "eval:personamem": "node --experimental-strip-types evals/benchmarks/run.ts personamem",
    "eval:beam": "node --experimental-strip-types evals/benchmarks/run.ts beam",
    "benchmark:setup": "node --experimental-strip-types evals/official/bootstrap.ts",
    "benchmark:install:omni-adapter": "node --experimental-strip-types evals/omnimemeval/install-adapter.ts",
    "benchmark:report:omni-perf": "node --experimental-strip-types evals/omnimemeval/report-perf.ts",
    "benchmark:prepare:no-memory": "node --experimental-strip-types evals/omnimemeval/prepare-no-memory.ts",
    "benchmark:audit:locomo": "node --experimental-strip-types evals/omnimemeval/audit-locomo-retrieval.ts",
    "benchmark:audit:beam": "python evals/omnimemeval/audit-beam-retrieval.py",
    "benchmark:audit:longmem": "python evals/omnimemeval/audit-longmemeval-retrieval.py",
    "benchmark:ablate:reverse-retrieval": "python evals/omnimemeval/reverse-retrieval-ablation.py",
    "benchmark:merge:longmem": "node --experimental-strip-types evals/omnimemeval/merge-longmemeval-shards.ts",
    "benchmark:validate": "npm run eval:longmem -- validate 1 && npm run eval:locomo -- validate 1 && npm run eval:personamem -- validate 1 && npm run eval:beam -- validate 1",
    "benchmark:score": "node --experimental-strip-types evals/official/score.ts",
    "benchmark:score:longmem": "node --experimental-strip-types evals/longmemeval/score.ts",
    "eval:recall-compression": "node --experimental-strip-types evals/recall-compression.ts",
    "eval:reasoning-workspace": "node --experimental-strip-types evals/reasoning-workspace/run.ts",
    "eval:scale": "node --experimental-strip-types evals/scale/run.ts",
    "eval:concurrency": "node --experimental-strip-types evals/concurrency/run.ts",
    "eval:perf-overhead": "node --experimental-strip-types evals/perf-overhead.ts",
    "eval:hierarchy": "node --experimental-strip-types evals/hierarchy-scale/run.ts",
    "index:qwen3": "node --experimental-strip-types scripts/index-qwen3.ts",
    "index:embeddings": "node --experimental-strip-types scripts/index-qwen3.ts",
    "index:status": "node --experimental-strip-types scripts/embedding-status.ts",
    "index:ann": "node --experimental-strip-types scripts/build-ann.ts",
    "package:check": "node --experimental-strip-types tools/verify-package.ts",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pi:prompt": "node --experimental-strip-types scripts/pi-control.ts prompt",
    "pi:state": "node --experimental-strip-types scripts/pi-control.ts state",
    "skill:nmg:sync": "node --experimental-strip-types scripts/sync-nmg-skill.ts",
    "skill:nmg:check": "node --experimental-strip-types scripts/sync-nmg-skill.ts --check",
    "docs:check": "node --experimental-strip-types scripts/verify-docs.mts",
    "agent:context": "node --experimental-strip-types tools/repo-context.ts",
    "agent:context:check": "node --experimental-strip-types tools/repo-context.ts --check",
    "agent:verify": "node --experimental-strip-types tools/agent-verify.ts",
    "verify:static": "npm run build && npm run package:check && npm run check && npm run lint && npm run format:check && npm run docs:check && npm run agent:context:check",
    "verify:product-ci": "npm run build && npm run test:coverage",
    "verify:research": "npm run test:research",
    "verify:node-compat": "npm run build && npm run check && npm run package:check",
    "verify:chaos": "npm run test:chaos",
    "bench:autodiff": "node --experimental-strip-types tools/autodiff-benchmark.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:product": "node --experimental-strip-types --test --test-concurrency=4 \"tests/cli/**/*.test.ts\" \"tests/core/**/*.test.ts\" \"tests/docker/**/*.test.ts\" \"tests/docs/**/*.test.ts\" \"tests/extensions/**/*.test.ts\" \"tests/guardrails/**/*.test.ts\" \"tests/integration/**/*.test.ts\" \"tests/prompts/**/*.test.ts\" \"tests/scripts/**/*.test.ts\" \"tests/skills/**/*.test.ts\" \"tests/support/**/*.test.ts\" \"tests/tools/**/*.test.ts\"",
    "test:research": "node --experimental-strip-types --test --test-concurrency=4 \"tests/benchmarks/**/*.test.ts\" \"tests/evals/**/*.test.ts\" \"tests/official/**/*.test.ts\"",
    "test:chaos": "npm run build && node --experimental-strip-types --test \"tests/chaos/*.test.ts\"",
    "test:cg": "node --experimental-strip-types --test tests/core/autodiff.test.ts tests/core/differentiable-controller.test.ts tests/core/hierarchical-activation.test.ts tests/core/memory-graph-reasoner.test.ts tests/core/fork-merge.test.ts tests/core/robustness.test.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@eslint/js": "^10.0.1",
    "@mizchi/server-faults": "^1.0.0",
    "@types/node": "24.12.4",
    "c8": "^12.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typebox": "1.1.38",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "optionalDependencies": {
    "usearch": "2.26.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "node-domexception": "^1.0.0",
    "search-query-parser": "^1.6.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "typescript@5.9.3": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "usearch@2.26.0": true
  }
}
